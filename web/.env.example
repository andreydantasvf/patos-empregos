# URL da API usada pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3333

# URL pública do site (SEO, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Opcional: URL da API usada pelo servidor do Next, quando ele a alcança por
# outro endereço (no Docker Compose é http://api:3333). Padrão: NEXT_PUBLIC_API_URL
# API_INTERNAL_URL=

# Opcional: link de convite do grupo de vagas no WhatsApp (https://chat.whatsapp.com/...)
NEXT_PUBLIC_WHATSAPP_URL=

# Opcional: link de suporte no WhatsApp (https://wa.me/55DDDNUMERO?text=...)
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=
