generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ENTERPRISE
}

enum JobType {
  CLT
  PJ
  FREELANCER
  INTERNSHIP
  TEMPORARY
}

enum JobPlan {
  BASIC
  PRO
  PREMIUM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([email])
  @@map("users")
}

model Job {
  id              String   @id @default(cuid())
  userId          String
  bannerUrl       String
  title           String
  companyName     String
  responsibleName String
  email           String
  whatsapp        String
  city            String
  type            JobType
  salary          String?
  description     String
  requirements    String
  benefits        String?
  applicationLink String?
  plan            JobPlan  @default(BASIC)
  amountPaid      String
  paidAt          DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([city])
  @@index([type])
  @@index([companyName])
  @@index([plan])
  @@index([active])
  @@map("jobs")
}
