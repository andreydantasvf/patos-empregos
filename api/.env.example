# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patos_empregos

# Server
PORT=3333
NODE_ENV=development

# URL pública do front-end (links das vagas nas mensagens do WhatsApp)
APP_URL=http://localhost:5173

# Auth (gere um valor próprio: openssl rand -base64 48)
JWT_SECRET=change_me_to_a_secure_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@patosempregos.com.br
ADMIN_PASSWORD=admin123

# CORS (use * for all origins or specify a domain)
CORS_ORIGIN=http://localhost:5173

# Integrações: opcionais fora de produção. Sem elas, a funcionalidade
# correspondente responde 503 e o resto da API funciona normalmente.

# Cloudinary (upload da imagem da vaga)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: pasta das imagens na Cloudinary (padrão: patos-empregos/banners)
CLOUDINARY_FOLDER=

# Mercado Pago (pagamento PIX)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Evolution API (publicação das vagas no grupo do WhatsApp)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GROUP_ID=
