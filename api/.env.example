# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patos_empregos

# Server
PORT=3333
NODE_ENV=development

# Auth
JWT_SECRET=change_me_to_a_secure_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@patosempregos.com.br
ADMIN_PASSWORD=admin123

# CORS (use * for all origins or specify a domain)
CORS_ORIGIN=*

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_VARIABLE=
CLOUDINARY_FOLDER=(opcional, para organizar as imagens em uma pasta específica de dev)

# Mercado pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Evolution API
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GROUP_ID=
